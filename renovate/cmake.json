{
  "description": "Update annotated CMake FetchContent release tags and commit pins",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^cmake\\/ExternalDependencies\\.cmake$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>[^\\s]+)[ \\t]*\\r?\\n[ \\t]*set\\([A-Za-z_][A-Za-z0-9_]*\\s+\"(?<currentDigest>[a-f0-9]{40})\"[ \\t]+# tag=(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)[ \\t]*(?:\\r?\\n|$)",
        "(?:^|\\r?\\n)[ \\t]*# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)[ \\t]*\\r?\\n[ \\t]*set\\([A-Za-z_][A-Za-z0-9_]*\\s+\"?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\"?[\\s)]"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
